{
  "max_level": "A1",
  "concepts": [
    { "id": "present", "level": "A1", "name": "Le présent de l’indicatif", "example": "Je suis à la maison." },
    { "id": "futur-proche", "level": "A1", "name": "Le futur proche (aller + infinitif)", "example": "Je vais finir le travail." },
    { "id": "imperative", "level": "A1", "name": "L’impératif", "example": "Finis ton travail !" },
    { "id": "articles", "level": "A1", "name": "Les articles définis et indéfinis", "example": "le chat, une voiture" },
    { "id": "contractions", "level": "A1", "name": "Les articles contractés (au, aux, du)", "example": "Je vais au travail." },
    { "id": "partitive", "level": "A1", "name": "L’article partitif", "example": "J’ai du travail." },
    { "id": "possessives", "level": "A1", "name": "Les adjectifs possessifs", "example": "mon chien, ta voiture" },
    { "id": "demonstratives", "level": "A1", "name": "Les adjectifs démonstratifs", "example": "ce soir, cette maison" },
    { "id": "adjectives", "level": "A1", "name": "L’accord et la place de l’adjectif", "example": "un petit chat, une voiture noire" },
    { "id": "numbers", "level": "A1", "name": "Les nombres", "example": "deux chiens" },
    { "id": "telling-time", "level": "A1", "name": "L’heure", "example": "à six heures" },
    { "id": "c-est", "level": "A1", "name": "C’est, ce sont", "example": "C’est mon chat." },
    { "id": "il-y-a", "level": "A1", "name": "Il y a", "example": "Il y a un chien à la maison." },
    { "id": "negation-ne-pas", "level": "A1", "name": "La négation ne… pas", "example": "Je ne suis pas là." },
    { "id": "question-intonation", "level": "A1", "name": "La question par l’intonation", "example": "Tu as une voiture ?" },
    { "id": "question-est-ce-que", "level": "A1", "name": "La question avec est-ce que", "example": "Est-ce que tu as un chat ?" },
    { "id": "question-words", "level": "A1", "name": "Les mots interrogatifs (où, quand, comment, pourquoi, qui, que, quel)", "example": "Où est le chat ?" },
    { "id": "question-inversion", "level": "A1", "name": "La question par inversion du pronom sujet", "example": "As-tu un chat ?" },
    { "id": "prepositions-place", "level": "A1", "name": "Les prépositions de lieu (à, chez, dans…)", "example": "Il est à la maison." },
    { "id": "stressed-pronouns", "level": "A1", "name": "Les pronoms toniques (moi, toi, lui…)", "example": "chez moi, avec lui" },
    { "id": "pronominal-verbs", "level": "A1", "name": "Les verbes pronominaux au présent", "example": "Il se lève." },

    { "id": "passe-compose", "level": "A2", "name": "Le passé composé", "example": "J’ai fini le travail.", "note": "Some courses start it at the end of A1." },
    { "id": "imparfait", "level": "A2", "name": "L’imparfait", "example": "Il était à la maison." },
    { "id": "futur-simple", "level": "A2", "name": "Le futur simple", "example": "Je finirai demain." },
    { "id": "passe-recent", "level": "A2", "name": "Le passé récent (venir de + infinitif)", "example": "Je viens de finir." },
    { "id": "present-progressive", "level": "A2", "name": "Être en train de + infinitif", "example": "Il est en train de finir." },
    { "id": "negation-other", "level": "A2", "name": "Les autres négations (ne… jamais, rien, plus, personne)", "example": "Il n’a plus de voiture." },
    { "id": "inversion-t", "level": "A2", "name": "L’inversion avec -t-", "example": "A-t-elle une voiture ?" },
    { "id": "inversion-complex", "level": "A2", "name": "L’inversion complexe (nom sujet + pronom)", "example": "Les chiens sont-ils à vous ?" },
    { "id": "inversion-negative", "level": "A2", "name": "L’inversion à la forme négative", "example": "Pourquoi ne dis-tu pas oui ?" },
    { "id": "pronoun-direct-object", "level": "A2", "name": "Les pronoms compléments directs (le, la, l’, les)", "example": "Je le fais." },
    { "id": "pronoun-indirect-object", "level": "A2", "name": "Les pronoms compléments indirects (lui, leur)", "example": "Je lui dis bonjour." },
    { "id": "pronoun-object-me-te", "level": "A2", "name": "Me, te, nous, vous compléments", "example": "Tu me dis tout." },
    { "id": "pronoun-y", "level": "A2", "name": "Le pronom y", "example": "J’y vais." },
    { "id": "pronoun-en", "level": "A2", "name": "Le pronom en", "example": "J’en ai deux." },
    { "id": "relative-qui-que", "level": "A2", "name": "Les pronoms relatifs qui et que", "example": "Le chat qui dort." },
    { "id": "relative-ou", "level": "A2", "name": "Le pronom relatif où", "example": "La maison où il habite." },
    { "id": "clause-que", "level": "A2", "name": "La subordonnée avec que (je sais que…)", "example": "Je sais qu’il est là." },
    { "id": "reported-speech", "level": "A2", "name": "Le discours indirect au présent", "example": "Il dit qu’il est fatigué." },
    { "id": "clause-time-cause", "level": "A2", "name": "Les subordonnées de temps et de cause (quand, parce que, comme…)", "example": "Je suis content quand il fait beau." },
    { "id": "clause-si", "level": "A2", "name": "Si + présent", "example": "Si tu vas à la maison, je vais avec toi." },
    { "id": "comparative", "level": "A2", "name": "Le comparatif", "example": "Il est plus grand que moi." },
    { "id": "superlative", "level": "A2", "name": "Le superlatif", "example": "C’est la plus belle voiture." },
    { "id": "possessive-pronouns", "level": "A2", "name": "Les pronoms possessifs", "example": "C’est le mien." },
    { "id": "demonstrative-pronouns", "level": "A2", "name": "Les pronoms démonstratifs (celui, celle…)", "example": "Celui-ci est à moi." },

    { "id": "conditionnel", "level": "B1", "name": "Le conditionnel présent", "example": "Je voudrais un chat.", "note": "Je voudrais is taught in A1 as a set phrase." },
    { "id": "subjonctif", "level": "B1", "name": "Le subjonctif présent", "example": "Il faut que tu finisses." },
    { "id": "plus-que-parfait", "level": "B1", "name": "Le plus-que-parfait", "example": "Il avait fini." },
    { "id": "pronouns-double", "level": "B1", "name": "Les doubles pronoms", "example": "Je le lui dis." },
    { "id": "relative-dont", "level": "B1", "name": "Le pronom relatif dont", "example": "L’homme dont je parle." },
    { "id": "ce-que-ce-qui", "level": "B1", "name": "Ce qui, ce que", "example": "Je sais ce que tu fais." },
    { "id": "restriction-ne-que", "level": "B1", "name": "La restriction ne… que", "example": "Il n’a qu’un chat." },
    { "id": "gerondif", "level": "B1", "name": "Le gérondif", "example": "Il travaille en chantant." },
    { "id": "mise-en-relief", "level": "B1", "name": "La mise en relief (c’est… qui, c’est… que)", "example": "C’est lui qui le dit." },
    { "id": "passive", "level": "B1", "name": "La voix passive", "example": "Le travail est fait par une femme." },
    { "id": "hypothesis-imparfait", "level": "B1", "name": "Si + imparfait, conditionnel", "example": "Si j’avais une voiture, j’irais en ville." },

    { "id": "subjonctif-passe", "level": "B2", "name": "Le subjonctif passé", "example": "Je suis content qu’il soit venu." },
    { "id": "conditionnel-passe", "level": "B2", "name": "Le conditionnel passé", "example": "J’aurais fini." },
    { "id": "futur-anterieur", "level": "B2", "name": "Le futur antérieur", "example": "J’aurai fini avant le soir." },
    { "id": "concordance-des-temps", "level": "B2", "name": "La concordance des temps", "example": "Il a dit qu’il finirait le soir." },
    { "id": "participe-present", "level": "B2", "name": "Le participe présent", "example": "Les hommes ayant fini partent." },
    { "id": "relatives-composes", "level": "B2", "name": "Les relatifs composés (lequel, auquel, duquel)", "example": "La maison dans laquelle il habite." },
    { "id": "ne-expletif", "level": "B2", "name": "Le ne explétif", "example": "Finis avant qu’il ne soit tard." },
    { "id": "passe-simple", "level": "B2", "name": "Le passé simple (à reconnaître)", "example": "Il fit son travail." }
  ]
}
