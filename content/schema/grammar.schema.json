{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "grammar.schema.json",
  "title": "Grammar",
  "description": "The grammar concepts sentences are tagged with, each at the CEFR level courses usually teach it, and the highest level the content's sentences may reach: content/grammar.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["max_level", "concepts"],
  "properties": {
    "max_level": { "$ref": "#/definitions/level" },
    "concepts": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/definitions/concept" }
    }
  },
  "definitions": {
    "level": { "enum": ["A1", "A2", "B1", "B2"] },
    "text": { "type": "string", "pattern": "\\S" },
    "concept": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "name"],
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z0-9]+(-[a-z0-9]+)*$" },
        "level": { "$ref": "#/definitions/level" },
        "name": { "$ref": "#/definitions/text" },
        "example": { "$ref": "#/definitions/text" },
        "note": { "$ref": "#/definitions/text" }
      }
    }
  }
}
