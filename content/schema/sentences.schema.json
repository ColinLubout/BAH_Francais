{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sentences.schema.json",
  "title": "Sentences",
  "description": "Sentences written in full, each with the verbs it is a Conjugaison prompt for and the nouns it is an example of: content/sentences/<name>.json.",
  "type": "object",
  "additionalProperties": false,
  "required": ["sentences"],
  "properties": {
    "sentences": {
      "type": "array",
      "items": { "$ref": "#/definitions/sentence" }
    }
  },
  "definitions": {
    "text": { "type": "string", "pattern": "\\S" },
    "sentence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "text"],
      "anyOf": [
        { "required": ["verbs"] },
        { "required": ["nouns"] }
      ],
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^s\\.[a-z0-9]+(-[a-z0-9]+)*(\\.[a-z0-9]+)*$"
        },
        "text": {
          "description": "The sentence in plain French, with no blank: Hier, nous sommes allés au cinéma.",
          "$ref": "#/definitions/text"
        },
        "verbs": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/verb" }
        },
        "nouns": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/noun" }
        },
        "credit": {
          "description": "A sentence from Tatoeba (CC BY 2.0 FR): its number there and its author, who must be credited.",
          "type": "object",
          "additionalProperties": false,
          "required": ["tatoeba", "author"],
          "properties": {
            "tatoeba": { "type": "integer", "minimum": 1 },
            "author": { "$ref": "#/definitions/text" }
          }
        }
      }
    },
    "verb": {
      "description": "A verb the sentence is a Conjugaison prompt for.",
      "type": "object",
      "additionalProperties": false,
      "required": ["verb", "tense", "person", "answer"],
      "properties": {
        "verb": {
          "type": "string",
          "pattern": "^v\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "tense": {
          "enum": ["present", "passe_compose", "imparfait", "futur_simple"]
        },
        "person": { "enum": ["1s", "2s", "3s", "1p", "2p", "3p"] },
        "answer": {
          "description": "The words of the text the drill blanks out, with any agreement (sommes allés); reflexive verbs include their pronoun (me lève).",
          "$ref": "#/definitions/text"
        },
        "alternatives": {
          "description": "Other right answers (sommes allées).",
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/definitions/text" }
        },
        "before": {
          "description": "When the word just before the answer is an elided l’, whether it is le or la. Other elided words are written in full by the app.",
          "enum": ["le", "la"]
        }
      }
    },
    "noun": {
      "description": "A noun the sentence is an example of.",
      "type": "object",
      "additionalProperties": false,
      "required": ["noun", "word"],
      "properties": {
        "noun": {
          "type": "string",
          "pattern": "^n\\.[a-z0-9]+(-[a-z0-9]+)*$"
        },
        "word": {
          "description": "The words of the text the noun takes (cinéma, haricots), shown in bold.",
          "$ref": "#/definitions/text"
        }
      }
    }
  }
}
